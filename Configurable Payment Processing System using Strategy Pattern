# Payment Strategies

class UPI:
    def pay(self, amount):
        print("Paid Rs.", amount, "using UPI")


class CreditCard:
    def pay(self, amount):
        print("Paid Rs.", amount, "using Credit Card")


class Cash:
    def pay(self, amount):
        print("Paid Rs.", amount, "using Cash")


# Payment Processing Class
class PaymentProcessor:
    def __init__(self, strategy):
        self.strategy = strategy

    def process_payment(self, amount):
        self.strategy.pay(amount)


# Main Program
while True:
    print("\n--- Payment Processing System ---")
    print("1. UPI Payment")
    print("2. Credit Card Payment")
    print("3. Cash Payment")
    print("4. Exit")

    choice = int(input("Enter your choice: "))

    if choice == 4:
        print("Program Ended")
        break

    amount = float(input("Enter payment amount: "))

    if choice == 1:
        payment = UPI()

    elif choice == 2:
        payment = CreditCard()

    elif choice == 3:
        payment = Cash()

    else:
        print("Invalid Choice")
        continue

    processor = PaymentProcessor(payment)
    processor.process_payment(amount)
